  {
    "id": "BS-M-001",
    "title": "Search in a Rotated Sorted Array",
    "topic": "Binary Search",
    "difficulty": "medium",
    "statement": "A sorted array of distinct integers was rotated at an unknown pivot (for example [0 1 2 4 5 6 7] became [4 5 6 7 0 1 2]). Given the rotated array and a target, print the index of the target, or -1 if it is absent. Aim for O(log n).",
    "input_format": "Line 1: integer n. Line 2: n distinct integers. Line 3: the target.",
    "output_format": "A single integer.",
    "constraints": "1 <= n <= 100000; -10^9 <= values <= 10^9",
    "learning_objectives": ["Decide which half is sorted", "Keep binary-search invariants with rotation"],
    "tags": ["binary-search", "array", "rotation"],
    "test_cases": [
      {"input": "7\n4 5 6 7 0 1 2\n0\n", "output": "4", "hidden": false},
      {"input": "7\n4 5 6 7 0 1 2\n3\n", "output": "-1", "hidden": false},
      {"input": "1\n1\n1\n", "output": "0", "hidden": true},
      {"input": "2\n3 1\n1\n", "output": "1", "hidden": true},
      {"input": "5\n5 1 2 3 4\n5\n", "output": "0", "hidden": true},
      {"input": "5\n2 3 4 5 1\n1\n", "output": "4", "hidden": true}
    ],
    "reference_solution": [
      "n = int(input())",
      "a = list(map(int, input().split()))",
      "t = int(input())",
      "lo, hi = 0, n - 1",
      "ans = -1",
      "while lo <= hi:",
      "    mid = (lo + hi) // 2",
      "    if a[mid] == t:",
      "        ans = mid",
      "        break",
      "    if a[lo] <= a[mid]:",
      "        if a[lo] <= t < a[mid]:",
      "            hi = mid - 1",
      "        else:",
      "            lo = mid + 1",
      "    else:",
      "        if a[mid] < t <= a[hi]:",
      "            lo = mid + 1",
      "        else:",
      "            hi = mid - 1",
      "print(ans)"
    ]
  },
