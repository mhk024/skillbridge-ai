    "statement": "Two arrays are each sorted in non-decreasing order. Print one array containing all elements of both, also sorted. Practise the merge step used by merge sort: walk both arrays with one index each.",
    "input_format": "Line 1: integer n. Line 2: n sorted integers. Line 3: integer m. Line 4: m sorted integers.",
    "output_format": "n + m space-separated integers on one line.",
    "constraints": "1 <= n, m <= 100000; -10^9 <= values <= 10^9",
    "learning_objectives": ["Understand the merge step of merge sort", "Advance the pointer of the smaller element"],
    "tags": ["sorting", "merge", "two-pointers"],
    "test_cases": [
      {"input": "3\n1 3 5\n3\n2 4 6\n", "output": "1 2 3 4 5 6", "hidden": false},
      {"input": "1\n5\n1\n3\n", "output": "3 5", "hidden": false},
      {"input": "2\n1 1\n3\n1 2 2\n", "output": "1 1 1 2 2", "hidden": true},
      {"input": "3\n-5 0 5\n2\n-6 6\n", "output": "-6 -5 0 5 6", "hidden": true}
