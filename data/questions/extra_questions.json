  {
    "id": "STK-M-001",
    "title": "Evaluate a Postfix Expression",
    "topic": "Stacks and Queues",
    "difficulty": "medium",
    "statement": "Evaluate an expression in postfix (reverse Polish) notation. Tokens are separated by spaces and are integers or one of + - * /. Division truncates toward zero. The expression is always valid and never divides by zero. Print the result.",
    "input_format": "A single line of space-separated tokens.",
    "output_format": "A single integer.",
    "constraints": "1 <= number of tokens <= 10000; all intermediate values fit in 64 bits",
    "learning_objectives": ["Use a stack to hold operands", "Pop the right operand before the left"],
    "tags": ["stack", "expression", "evaluation"],
    "test_cases": [
      {"input": "2 1 + 3 *\n", "output": "9", "hidden": false},
      {"input": "4 13 5 / +\n", "output": "6", "hidden": false},
      {"input": "10 6 9 3 + -11 * / * 17 + 5 +\n", "output": "22", "hidden": true},
      {"input": "5\n", "output": "5", "hidden": true},
      {"input": "3 4 -\n", "output": "-1", "hidden": true},
      {"input": "7 -2 /\n", "output": "-3", "hidden": true},
      {"input": "-7 2 /\n", "output": "-3", "hidden": true}
    ],
    "reference_solution": [
      "tokens = input().split()",
      "st = []",
      "for t in tokens:",
      "    if t in ('+', '-', '*', '/'):",
      "        b = st.pop()",
      "        a = st.pop()",
      "        if t == '+':",
      "            st.append(a + b)",
      "        elif t == '-':",
      "            st.append(a - b)",
      "        elif t == '*':",
      "            st.append(a * b)",
      "        else:",
      "            q = abs(a) // abs(b)",
      "            st.append(-q if (a < 0) != (b < 0) else q)",
      "    else:",
      "        st.append(int(t))",
      "print(st[0])"
    ]
  },
  {
    "id": "TREE-E-001",
    "title": "Count Leaf Nodes",
    "topic": "Trees",
    "difficulty": "easy",
    "statement": "A binary tree is given in level order. N means 'no node'. For each existing node, in order, the next two values are its left and right child (N if absent); trailing N values may be omitted. Print the number of leaf nodes (nodes with no children).",
    "input_format": "A single line of space-separated tokens (integers or N).",
    "output_format": "A single integer.",
    "constraints": "1 <= number of tokens <= 100000; the first token is not N.",
    "learning_objectives": ["Rebuild a tree from level-order input", "Recognise leaves as nodes without children"],
    "tags": ["tree", "bfs", "level-order"],
    "test_cases": [
      {"input": "1 2 3 N N 4 5\n", "output": "3", "hidden": false},
      {"input": "1\n", "output": "1", "hidden": false},
      {"input": "1 2 N 3 N\n", "output": "1", "hidden": true},
      {"input": "1 N 2 N 3\n", "output": "1", "hidden": true},
      {"input": "5 3 8 1 4 7 9\n", "output": "4", "hidden": true},
      {"input": "1 2 3 4 N N N 5\n", "output": "2", "hidden": true}
    ],
    "reference_solution": [
      "from collections import deque",
      "vals = input().split()",
      "q = deque([0])",
      "i = 1",
      "leaves = 0",
      "while q:",
      "    q.popleft()",
      "    kids = 0",
      "    for _ in range(2):",
      "        if i < len(vals):",
      "            if vals[i] != 'N':",
      "                q.append(i)",
      "                kids += 1",
      "            i += 1",
      "    if kids == 0:",
      "        leaves += 1",
      "print(leaves)"
    ]
  },
  {
    "id": "GRAPH-E-001",
    "title": "Is There a Path?",
    "topic": "Graphs",
    "difficulty": "easy",
    "statement": "An undirected graph has n vertices numbered 0 to n-1 and m edges. Given two vertices s and t, print YES if t can be reached from s, otherwise print NO. A vertex can always reach itself.",
    "input_format": "Line 1: n and m. Next m lines: two integers u v (an edge). Last line: s and t.",
    "output_format": "YES or NO.",
    "constraints": "1 <= n <= 100000; 0 <= m <= 200000",
    "learning_objectives": ["Store a graph as adjacency lists", "Traverse with BFS and track visited vertices"],
    "tags": ["graph", "bfs", "reachability"],
    "test_cases": [
      {"input": "5 3\n0 1\n1 2\n3 4\n0 2\n", "output": "YES", "hidden": false},
      {"input": "5 3\n0 1\n1 2\n3 4\n0 4\n", "output": "NO", "hidden": false},
      {"input": "1 0\n0 0\n", "output": "YES", "hidden": true},
      {"input": "4 2\n0 1\n2 3\n1 2\n", "output": "NO", "hidden": true},
      {"input": "4 3\n0 1\n1 2\n2 3\n0 3\n", "output": "YES", "hidden": true}
    ],
    "reference_solution": [
      "from collections import deque",
      "n, m = map(int, input().split())",
      "adj = [[] for _ in range(n)]",
      "for _ in range(m):",
      "    u, v = map(int, input().split())",
      "    adj[u].append(v)",
      "    adj[v].append(u)",
      "s, t = map(int, input().split())",
      "seen = [False] * n",
      "seen[s] = True",
      "q = deque([s])",
      "while q:",
      "    u = q.popleft()",
      "    for v in adj[u]:",
      "        if not seen[v]:",
      "            seen[v] = True",
      "            q.append(v)",
      "print('YES' if seen[t] else 'NO')"
    ]
  },
