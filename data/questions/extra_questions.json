  {
    "id": "STR-M-001",
    "title": "Longest Palindromic Substring Length",
    "topic": "Strings",
    "difficulty": "medium",
    "statement": "Given a string, print the length of its longest contiguous substring that reads the same forwards and backwards.",
    "input_format": "A single line containing the string (no spaces).",
    "output_format": "A single integer.",
    "constraints": "1 <= length <= 1000",
    "learning_objectives": ["Expand around a centre", "Handle odd and even length palindromes"],
    "tags": ["string", "palindrome", "two-pointers"],
    "test_cases": [
      {"input": "babad\n", "output": "3", "hidden": false},
      {"input": "cbbd\n", "output": "2", "hidden": false},
      {"input": "a\n", "output": "1", "hidden": true},
      {"input": "abacdfgdcaba\n", "output": "3", "hidden": true},
      {"input": "forgeeksskeegfor\n", "output": "10", "hidden": true},
      {"input": "abcd\n", "output": "1", "hidden": true}
    ],
    "reference_solution": [
      "s = input().strip()",
      "best = 0",
      "for c in range(len(s)):",
      "    for l, r in ((c, c), (c, c + 1)):",
      "        while l >= 0 and r < len(s) and s[l] == s[r]:",
      "            l -= 1",
      "            r += 1",
      "        best = max(best, r - l - 1)",
      "print(best)"
    ]
  },
