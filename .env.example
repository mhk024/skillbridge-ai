# Copy this file to .env and fill in real values. NEVER commit .env.

APP_ENV=development

# SQLite file inside the project. Leave blank to use the default (data/skillbridge.db).
DATABASE_URL=

# Code execution runs submitted Python in a local subprocess.
# Keep true only on your own machine. Set false on any public hosting.
ENABLE_CODE_EXECUTION=true

# LLM settings (optional: the app works without them)
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=